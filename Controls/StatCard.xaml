<UserControl
    x:Class="TempFileCleaner.Controls.StatCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TempFileCleaner.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="100"
    d:DesignWidth="200"
    Background="Transparent"
    mc:Ignorable="d">
    <Border
        Margin="8"
        Padding="10,4"
        Background="{Binding BackgroundColor, ElementName=root}"
        BorderBrush="{Binding BorderColor, ElementName=root}"
        BorderThickness="2"
        CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="6"
                Opacity="0.7"
                ShadowDepth="5"
                Color="#000000" />
        </Border.Effect>
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock
                Margin="0,0,0,4"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{Binding TitleColor, ElementName=root}"
                Text="{Binding Title, ElementName=root}" />
            <TextBlock
                x:Name="ValueTextBlock"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{Binding ValueColor, ElementName=root}"
                Text="{Binding Value, ElementName=root}" />
        </StackPanel>

    </Border>
</UserControl>
